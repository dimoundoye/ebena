# Variables du déploiement Docker (docker-compose.yml). Copier en .env puis compléter.
# Mettre la valeur entre guillemets si elle contient # ou des espaces, ex. DB_PASSWORD="mot#de passe"

# Port public du site sur la machine (mettre 80 si aucun autre proxy)
HTTP_PORT=8080
# URL publique du site (liens et logo dans les e-mails)
SITE_URL=https://votre-domaine.fr

# Base de données
DB_PASSWORD=

# Back-office : clé de session (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
# Premier compte admin, créé au premier démarrage si aucun n'existe
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true dès que le site est servi en HTTPS
COOKIE_SECURE=false
# Nombre de proxys devant l'API (1 = le Nginx du conteneur frontend ; 2 si un autre proxy HTTPS est devant)
TRUST_PROXY=1

# E-mails sortants (laisser vide pour désactiver l'envoi)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ÉBËNA 2027 <contacts.ebena@gmail.com>"
NOTIFY_TO=contacts.ebena@gmail.com
