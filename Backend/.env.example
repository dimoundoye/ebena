# Copier ce fichier en .env puis compléter les valeurs.
# Mettre la valeur entre guillemets si elle contient # ou des espaces, ex. DB_PASSWORD="mot#de passe"

NODE_ENV=development
PORT=4000

# URL publique du site (liens et logo dans les e-mails)
SITE_URL=http://localhost:5173

# Origines autorisées si le front est servi sur un autre domaine que l'API (séparées par des virgules).
# Inutile en local (proxy Vite) et derrière le Nginx fourni (même domaine).
CORS_ORIGIN=

# Derrière un reverse proxy (Nginx, Docker) : 1
TRUST_PROXY=

# --- PostgreSQL (soit DATABASE_URL, soit les variables DB_*) ---
# DATABASE_URL=postgres://user:motdepasse@localhost:5432/ebena
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=ebena

# --- Back-office ---
# Clé de signature des sessions : générer avec
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_SESSION_HOURS=8
# Premier compte admin créé automatiquement si aucun n'existe (ou utiliser : npm run create-admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true si le site est servi en HTTPS (par défaut : true quand NODE_ENV=production)
COOKIE_SECURE=

# --- E-mails (laisser SMTP_HOST vide en local : les e-mails sont affichés dans la console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ÉBËNA 2027 <contacts.ebena@gmail.com>"
# Adresse qui reçoit les notifications (réservations, messages)
NOTIFY_TO=contacts.ebena@gmail.com

# Nombre d'envois autorisés par formulaire et par adresse IP sur 10 minutes
FORM_RATE_LIMIT=30
